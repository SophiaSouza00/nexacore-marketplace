# ===================================================
# NEXACORE — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local ou .env e preencha com seus dados reais.
# NUNCA envie o arquivo .env ou .env.local para o repositório Git!
# ===================================================

# Conexão com o banco de dados PostgreSQL (Ex: Neon, Supabase ou PostgreSQL Local)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.neon.tech/nexacoredb?sslmode=require"

# Chave secreta para criptografia e validação das sessões de usuário
# Gere uma chave aleatória e segura em produção (ex: openssl rand -base64 32)
SESSION_SECRET="sua-chave-secreta-aleatoria-com-minimo-32-caracteres"

# Nome público da aplicação
NEXT_PUBLIC_APP_NAME="NexaCore"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciais iniciais para o primeiro administrador (usado apenas no script de seed)
ADMIN_INITIAL_NAME="Administrador NexaCore"
ADMIN_INITIAL_EMAIL="admin@nexacore.com.br"
ADMIN_INITIAL_PASSWORD="AltereEstaSenhaForte123!"
